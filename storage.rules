rules_version = '2';

// =====================================================================
// AURA Construction — Cloud Storage security rules
//
//   • Project photos are publicly readable (they appear on the site).
//   • Only the admin (listed in Firestore /admins/{uid}) may upload or
//     delete, and only real images up to 5 MB.
//   • Everything else is denied.
// =====================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isSafeImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /project-photos/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isSafeImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
